  "scripts": {
    "start": "tsx src/playground/index.ts",
    "record": "tsx src/playground/record.ts",
    "replay": "tsx src/playground/replay.ts",
    "build": "pnpm run clean && pnpm run build:cjs",
    "build:cjs": "tsc -p tsconfig.json",
    "build:link": "pnpm run build && pnpm link --global",
    "type-check:watch": "pnpm run type-check -- --watch",
    "type-check": "tsc --noEmit",
    "clean": "rimraf ./build && rimraf ./src/samples",
    "lint": "eslint ./src --ext .ts",
    "fix": "eslint ./src --ext .ts --fix",
    "test": "jest",
    "test:schema": "rimraf ./src/samples && pnpm run build && tsx src/playground/generate-samples.ts && pnpm run fix && pnpm run test && pnpm run clean && echo 'Schema test done'",
    "prepare": "pnpm run build",
    "pretest": "pnpm run build",
    "posttest": "pnpm run lint",
    "format": "prettier --write .",
    "check": "prettier --check ."
